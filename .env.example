# Local development defaults. Copy to .env and change values outside this machine.
# .env is gitignored. Do not commit real secrets.
#
# Docker Compose project name is emlak-site (docker-compose.yml `name`).
#   docker compose up -d --build
#   http://localhost:3000
#
# The api service does not use the host DATABASE_URL below. Compose rewrites it to
# postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>?schema=public
# so the API reaches PostgreSQL on the Docker network. localhost inside a container
# is the container itself.
#
# POSTGRES_PORT is only the host port for inspection, Prisma on the host, and e2e.
# If 5432 is already taken, change POSTGRES_PORT and the host DATABASE_URL together.
#
# The web image built by Compose always uses VITE_API_BASE_URL=/api/v1.
# That value is a build arg in docker-compose.yml and is independent of the host
# VITE_API_BASE_URL below, so `npm run dev:web` can still call the host API.
# apps/web/server.mjs proxies /api/v1/* to API_PROXY_TARGET (http://api:3001 in Compose).
#
# JWT_SECRET and JWT_REFRESH_SECRET are required, must differ, and need 32+ characters.
# Compose reads them from .env. They are not hardcoded in the image.
#
# STORAGE_LOCAL_ROOT is empty on the host (API uses ./storage).
# The api container sets STORAGE_LOCAL_ROOT=/app/storage and mounts the storage_data volume.
# COOKIE_SECURE=false is required for http://localhost. Production HTTPS uses true.
# CORS_ORIGIN stays http://localhost:3000 so login/refresh/logout accept that Origin.
POSTGRES_DB=emlak
POSTGRES_USER=emlak
POSTGRES_PASSWORD=emlak_local_password
POSTGRES_PORT=5432

DATABASE_URL=postgresql://emlak:emlak_local_password@localhost:5432/emlak?schema=public

NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

JWT_SECRET=replace-with-a-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-string-32c
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
AUTH_RATE_LIMIT=10
AUTH_RATE_TTL_MS=60000

# local is the only driver in this phase. An S3-compatible driver can replace it later.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=

VITE_DATA_MODE=api
VITE_API_BASE_URL=http://localhost:3001/api/v1
