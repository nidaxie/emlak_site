# Local development defaults. Copy to .env and change values outside this machine.
POSTGRES_DB=emlak
POSTGRES_USER=emlak
POSTGRES_PASSWORD=emlak_local_password
POSTGRES_PORT=5432

DATABASE_URL=postgresql://emlak:emlak_local_password@localhost:5432/emlak?schema=public

NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

JWT_SECRET=replace-with-a-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-string-32c
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
AUTH_RATE_LIMIT=10
AUTH_RATE_TTL_MS=60000

# local is the only driver in this phase. An S3-compatible driver can replace it later.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=

VITE_DATA_MODE=api
VITE_API_BASE_URL=http://localhost:3001/api/v1
